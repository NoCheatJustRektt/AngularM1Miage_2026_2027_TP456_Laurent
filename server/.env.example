# Modèle de configuration de l'API. Copier ce fichier en « .env » et l'adapter.
# Ne jamais committer le fichier .env (il est dans .gitignore).
# Liste complète et rôle de chaque variable : docs/DEPLOIEMENT.md

# development | test | production
NODE_ENV=development

# Port de l'API
PORT=3000

# Chaîne de connexion MongoDB (obligatoire en production).
# En développement, si elle est absente, une base MongoDB en mémoire est démarrée
# (les données sont perdues à l'arrêt du serveur).
# MONGODB_URI=mongodb+srv://<utilisateur>:<mot-de-passe>@<cluster>.mongodb.net/studyshare-dev

# Adresse de l'application Angular autorisée à appeler l'API (obligatoire en production)
CORS_ORIGIN=http://localhost:4200

# Stockage des fichiers : memory (Supabase sera ajouté à l'étape 2)
STORAGE_DRIVER=memory
